# Experiment Hub — environment variables
# Copy to .env.local for local dev (Next.js loads .env.local automatically).
# For Vercel: set these in Project Settings → Environment Variables.
#
# .env.local is also the canonical fallback for experiment prototypes:
# their scripts load their own local .env first (which wins when present),
# then fall back to this repo root .env.local — so shared keys like
# NOTION_TOKEN and SUPABASE_* only need to live here once. See e.g.
# experiments/etsy-notion-sync/prototype/.env.example.
#
# Worktrees get there by symlink. A worktree is a separate directory, so
# Next.js would otherwise read a .env.local sitting next to it — and those
# copies drifted badly: one worktree held the only copy of the live Stripe
# keys, another had no env file at all, and any secret added inside a worktree
# died when that worktree was recycled. scripts/link-worktree-env.sh points
# every worktree's .env.local at the main checkout's file, and the SessionStart
# hook runs it, so a new worktree is wired before you notice it existed.
#
# THIS FILE IS THE REGISTRY. Every key below is one you already have somewhere.
# Check here before going to hunt a credential — values live in .env.local,
# names and provenance live here.
#
# WHICH KEYS ARE SECRETS: keys annotated `vault:` below are stored in
# .env.local as op:// REFERENCES, resolved from the 1Password "BHD Labs"
# vault by `op run` when `pnpm dev` starts — never paste a literal value for
# them (docs/SECRETS_RUNBOOK.md). Everything unannotated is non-secret config
# and stays plaintext. Deployed copies (Vercel, GitHub Actions) are pushed
# from the vault by scripts/sync-secrets.sh, whose manifest mirrors this
# registry. Keys marked `vault (CI/deploy only)` are consumed by workflows or
# Vercel, live in the vault for sync, and never appear in .env.local at all.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Used for all experiment waitlist/form submissions.
# Find these in your Supabase project: Settings → API (or the Connect button).
#
# SUPABASE_PUBLISHABLE_KEY is the publishable key (sb_publishable_... or anon JWT).
# Safe to store in .env.local — does not bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY is optional — only needed for admin content editing.
SUPABASE_URL=                   # plaintext (non-secret); vault holds a copy for sync
SUPABASE_PUBLISHABLE_KEY=       # plaintext (safe-by-design); vault holds a copy for CI sync
# SUPABASE_SERVICE_ROLE_KEY=    # vault: op://BHD Labs/Supabase experiment-hub/service role key

# Required table (run once in Supabase SQL editor):
#
#   create table experiment_submissions (
#     id          uuid        default gen_random_uuid() primary key,
#     experiment  text        not null,
#     email       text        not null,
#     name        text,
#     source      text        default 'landing-page',
#     notes       text,
#     metadata    jsonb,
#     created_at  timestamptz default now()
#   );

# Required table (run once in Supabase SQL editor):
#
#   create table experiment_content (
#     id              uuid        default gen_random_uuid() primary key,
#     experiment_id   text        not null,
#     content_type    text        not null,
#     content         text        not null,
#     updated_at      timestamptz default now(),
#     unique (experiment_id, content_type)
#   );

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Classic PAT with repo read scope — used to sync pull requests from GitHub.
# Generate at: https://github.com/settings/tokens
# GITHUB_TOKEN=                 # vault: op://BHD Labs/GitHub/api token

# ─── Etsy sync (etsy-notion-sync experiment) ─────────────────────────────────
# PAT with actions:write on this repo — lets the hub's "Sync now" button
# dispatch .github/workflows/etsy-notion-sync.yml. Server-side only.
# GITHUB_DISPATCH_TOKEN=        # vault: op://BHD Labs/GitHub/dispatch token
# Repo the workflow lives in (default: beckharrisdesign/experiment-hub).
# ETSY_SYNC_REPO=

# ─── Edit mode ────────────────────────────────────────────────────────────────
# Secret used to unlock in-browser editing of experiment content.
# Visit /experiments/<slug>?edit=YOUR_SECRET to activate for 8 hours.
# Server-side only — never prefix with NEXT_PUBLIC_.
ADMIN_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Restrict CORS for /api/landing-submission (default: *)
# LANDING_CORS_ORIGIN=https://your-landing-domain.com

# ─── Notion ───────────────────────────────────────────────────────────────────
# NOTION_TOKEN: internal integration secret (notion.so/profile/integrations).
# Share the target databases with the integration. On Replit, the connector
# handles auth automatically and NOTION_TOKEN can be omitted.
# NOTION_TOKEN=                 # vault: op://BHD Labs/Notion/token
#
# When Notion auth is available (NOTION_TOKEN, or the Replit connector) AND
# NOTION_EXPERIMENTS_DATA_SOURCE_ID is set, experiments are read from the
# "BHD Labs Projects" Notion database instead of Supabase (Supabase/JSON
# remain as fallbacks). The data source id for BHD Labs Projects is
# 399b908d-7b37-80cb-beb5-000b54ca2967.
# NOTION_EXPERIMENTS_DATA_SOURCE_ID=   # vault: op://BHD Labs/Notion/experiments data source id

# ─── Etsy Listing Kit (experiment: etsy-listing-kit) ─────────────────────────
# Paid one-time asset-pack funnel. Store BOTH Stripe key pairs once and flip
# STRIPE_MODE (test|live) to switch — no editing secret values to change modes.
# No publishable key needed (server-side hosted Checkout). Price is created inline.
# STRIPE_MODE=test              # test|live — which key pair the app uses (plaintext config)
# STRIPE_SECRET_KEY_TEST=       # vault: op://BHD Labs/Stripe/secret key test
# STRIPE_SECRET_KEY_LIVE=       # vault: op://BHD Labs/Stripe/secret key live
# STRIPE_WEBHOOK_SECRET_TEST=   # plaintext, intentionally EMPTY — no test-mode webhook
#                               # endpoint exists yet; the vault field is a scaffold
#                               # placeholder until one is created (sync refuses to push it)
# STRIPE_WEBHOOK_SECRET_LIVE=   # vault: op://BHD Labs/Stripe/webhook secret live
# (Unsuffixed STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET still work as a fallback.)
# revenue:test always uses the LIVE key (STRIPE_SECRET_KEY_LIVE) — it counts real money.
# ELK_LAUNCHED_AT=              # ISO 8601 launch timestamp — revenue:test counts only after this
# ELK_SITE_URL=                 # production origin, for email download links
# ELK_EMAIL_FROM=               # brand from-address for confirmation/refund emails
# Admin (webhook writes, bypasses RLS — server-only, never expose):
# SUPABASE_SERVICE_ROLE_KEY=

# ─── pdf-metadata-viewer (hosted) ─────────────────────────────────────────────
# openspec/changes/pdf-metadata-viewer-cloud — design.md D5.
# The tool reads a household archive of medical, financial and school records,
# so nothing here is optional in production and none of it is enterable in the UI.
#
# Session signing key for the pdf-session cookie. Any long random string; the
# cookie is a signed assertion, never a credential, so rotating this only
# invalidates live sessions. Server-only.
# PDF_SESSION_SECRET=           # vault (CI/deploy only): op://BHD Labs/PDF session/secret
#
# The single Google `sub` claim permitted to sign in. Keyed on `sub` and never
# on email, which is reassignable.
#
# Exactly one entry, enforced in code. Unset or empty admits nobody, and so does
# a list of two or more — a second entry would silently make this instance
# multi-tenant, so it fails closed and logs why rather than widening access.
# Not a credential — it authenticates nobody, it only names who is permitted.
# Vaulted anyway because it is the one production value that cannot be looked
# up again: recovering it means failing a sign-in on purpose and reading the
# rejected claim out of the runtime log.
# PDF_ALLOWED_GOOGLE_SUBS=      # vault (CI/deploy only): op://BHD Labs/Google OAuth pdf-metadata-viewer/allowed sub
#
# Google OAuth client, used for BOTH sign-in (openid email profile) and Drive.
# One client, one consent — the identity scopes are non-sensitive and add no
# verification burden; the Drive scope is the one that decides that question.
# PDF_GOOGLE_CLIENT_ID=         # vault (CI/deploy only): op://BHD Labs/Google OAuth pdf-metadata-viewer/client id
# PDF_GOOGLE_CLIENT_SECRET=     # vault (CI/deploy only): op://BHD Labs/Google OAuth pdf-metadata-viewer/client secret
# PDF_GOOGLE_REDIRECT_URI=      # vault (CI/deploy only): op://BHD Labs/Google OAuth pdf-metadata-viewer/redirect uri — must match the console entry exactly
#
# Picker developer key. Google's Picker docs require an API key alongside the
# OAuth token; without it the picker iframe returns a bare 403. Browser-visible
# by design — restrict it to the Picker API and to your own hosts.
# PDF_GOOGLE_API_KEY=           # vault (CI/deploy only): op://BHD Labs/Google OAuth pdf-metadata-viewer/api key
#
# AI suggestions only; everything else works without it. The key itself is
# documented once in the OpenAI section below — do not add a second entry.

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is the one to set. It is the only spelling any code in this
# repo reads — packages/ai-utils and the seed organizer routes all use it.
# OPENAI_API_KEY=               # vault: op://BHD Labs/OpenAI/credential
#
# OPEN_AI_API_KEY (underscored) is legacy: it sat in .env.local for months and
# is referenced by nothing. Harmless to keep, but do not add it to a new
# environment, and do not assume setting it does anything. It is worth naming
# here precisely because searching for one spelling never finds the other,
# which is how a key you already had becomes a key you go and re-issue.

# ─── Figma ────────────────────────────────────────────────────────────────────
# Personal access token for the Figma MCP / REST API (figma.com → Settings →
# Security → Personal access tokens). See rules/figma.mdc.
# FIGMA_ACCESS_TOKEN=           # vault: op://BHD Labs/Figma/access token

# ─── CI-only secrets (GitHub Actions — never in .env.local) ──────────────────
# Consumed by etsy-notion-sync.yml, history-accumulate.yml and deploy-hub.yml.
# They live in the BHD Labs vault and are pushed to GitHub Actions by
# scripts/sync-secrets.sh; they are listed here only so the registry is
# complete. Do not add them to .env.local.
# ETSY_API_KEY=                       # vault (CI/deploy only): op://BHD Labs/Etsy/api key
# ETSY_SHARED_SECRET=                 # vault (CI/deploy only): op://BHD Labs/Etsy/shared secret
# ETSY_SHOP_ID=                       # vault (CI/deploy only): op://BHD Labs/Etsy/shop id
# NOTION_INVENTORY_DB_ID=             # vault (CI/deploy only): op://BHD Labs/Notion/inventory db id
# NOTION_HISTORY_DATA_SOURCE_ID=      # vault (CI/deploy only): op://BHD Labs/Notion/history data source id
# Simple Seed Organizer's OWN Supabase project (orlpgxqbesxvlhlkbnqy) — a
# different project from the hub's. Its live test skips when these are unset.
# SSO_SUPABASE_URL=                   # vault (CI/deploy only): op://BHD Labs/Supabase simple-seed-organizer/url
# SSO_SUPABASE_SERVICE_ROLE_KEY=      # vault (CI/deploy only): op://BHD Labs/Supabase simple-seed-organizer/service role key
# VERCEL_TOKEN=                       # vault (CI/deploy only): op://BHD Labs/Vercel/token
# VERCEL_ORG_ID=                      # vault (CI/deploy only): op://BHD Labs/Vercel/org id
# VERCEL_PROJECT_ID=                  # vault (CI/deploy only): op://BHD Labs/Vercel/project id
#
# Consumed by a DIFFERENT repository: beckharrisdesign/mvds, whose Chromatic
# visual-regression job is its only CI secret. It is registered here because
# this file is the registry of record and the vault is the master copy — not
# because anything in this repo reads it. sync-secrets.sh pushes it outward via
# a gh-repo: target. Nothing about it belongs in .env.local.
# CHROMATIC_PROJECT_TOKEN=            # vault (CI/deploy only): op://BHD Labs/Chromatic/project token

# ─── Client-visible app config ────────────────────────────────────────────────
# NEXT_PUBLIC_* is exposed to the browser by Next.js — never put a secret here.
# The Supabase pair below duplicates SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY
# above under the NEXT_PUBLIC_ prefix, which is what client components read.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_APP_NAME=
# NEXT_PUBLIC_APP_URL=

# ─── Local dev only ───────────────────────────────────────────────────────────
# Not secrets. Paths the hub reads experiment data from, and the dev port.
# DATA_DIR=
# EXPERIMENTS_DIR=
# NODE_ENV=development
# PORT=3000
