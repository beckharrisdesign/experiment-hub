{
  "schemaVersion": 1,
  "propertyRef": "../properties/pdf-organizer.json",
  "userRole": "Household admin (Katy), signed in",
  "startingState": {
    "path": "/pdf-metadata-viewer",
    "description": "Document list for the PDF Tests folder, no search or filter"
  },
  "testData": {
    "file": "Sync-test-3-pages.pdf",
    "fileSearch": "Sync-test",
    "broadSearch": "pdf"
  },
  "fixtureRef": "PDF Tests folder in Drive: made-up documents only (confirmed by Katy, 2026-11-24)",
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "locale": "en-US",
  "authRef": "katy-google",
  "limits": {
    "maxDurationMs": 90000,
    "maxActions": 10,
    "stepTimeoutMs": 20000
  },
  "allowedMutations": [],
  "comparisonContext": "2026-11-pdf-v1",
  "id": "pdfo-step-through-results",
  "name": "Work through search results",
  "familiarity": "Reviewing a batch of documents one after another",
  "goal": "Move through the results without losing the search",
  "notes": "Searches for 'pdf', which matches every filename, so there is always a next document. A keyword filter could leave the test file alone in the results, with no Next.",
  "verify": [
    {
      "id": "reload-list",
      "do": "reload",
      "note": "Fresh load of the list address the path returned to"
    },
    {
      "id": "search-kept",
      "do": "assertValue",
      "target": {
        "role": "searchbox",
        "name": "Search documents"
      },
      "value": "{{data.broadSearch}}",
      "principles": [
        "user-control-and-freedom"
      ]
    }
  ],
  "scenarios": {
    "normal": {
      "kind": "normal",
      "description": "List \u2192 search \u2192 open \u2192 Next \u2192 All documents",
      "steps": [
        {
          "id": "search-everything",
          "do": "fill",
          "target": {
            "role": "searchbox",
            "name": "Search documents"
          },
          "value": "{{data.broadSearch}}"
        },
        {
          "id": "open-document",
          "do": "click",
          "target": {
            "role": "link",
            "name": "{{data.file}}"
          }
        },
        {
          "id": "detail-shown",
          "do": "assertVisible",
          "target": {
            "role": "heading",
            "name": "{{data.file}}"
          },
          "screenshot": true
        },
        {
          "id": "next-document",
          "do": "click",
          "target": {
            "role": "link",
            "name": "Next:",
            "exact": false
          },
          "note": "Next's name is 'Next: <filename>'"
        },
        {
          "id": "back-to-list",
          "do": "click",
          "target": {
            "role": "link",
            "name": "\u2190 All documents"
          },
          "principles": [
            "user-control-and-freedom"
          ]
        },
        {
          "id": "search-still-there",
          "do": "assertValue",
          "target": {
            "role": "searchbox",
            "name": "Search documents"
          },
          "value": "{{data.broadSearch}}",
          "screenshot": true
        }
      ]
    }
  }
}
