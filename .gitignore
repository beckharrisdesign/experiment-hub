# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
# Also ignore node_modules in experiment prototypes
**/experiments/**/node_modules/

# Testing
/coverage
*.lcov
.nyc_output

# Next.js
/.next/
/out/
next-env.d.ts
# Also ignore Next.js build artifacts in experiment prototypes
**/experiments/**/.next/
**/experiments/**/out/

# Production
/build
/dist

# Misc
.DS_Store
*.pem
*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files
.env
.env*.local
# Belt-and-braces: env backups are named .env.bak-<ts>.local so the rule
# above already covers them, but a stray *.bak of a secrets file must
# never be committable on a naming slip.
.env*.bak*
*.env.bak*
.env.development.local
.env.test.local
.env.production.local

# scripts/sync-secrets.sh state — SHA-256 hashes of synced values, never the
# values themselves. Ignored because it is per-machine bookkeeping, not shared
# config: committing it would make one machine's sync history everyone's.
.secrets-sync-state

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local worktree clones of linked repos (not for cloud sessions)
worktrees/

# Experiment Hub specific
!/data/.gitkeep
# Note: experiments/ folder and its contents are tracked
# Individual experiment node_modules and build artifacts are ignored below

# Experiment prototype databases and data files
**/experiments/**/data/*.sqlite
**/experiments/**/data/*.sqlite-journal
**/experiments/**/data/*.db
**/experiments/**/data/*.txt

# Experiment prototype uploads/exports (keep directory structure)
**/experiments/**/public/uploads/*
!**/experiments/**/public/uploads/.gitkeep
**/experiments/**/public/exports/*
!**/experiments/**/public/exports/.gitkeep

# Playwright test artifacts
**/playwright-report/
**/test-results/
**/playwright/.cache/

# Temporary files
*.tmp
*.temp
.cache/
.site-map/
artifacts/site-map/

# Logs
logs/
*.log

.claude/worktrees/
.claude/settings.local.json

# Obsidian — local vault for this repo (notes/settings are not part of the app on GitHub)
BHD Labs/
BHD Labs Hub/

# pdf-metadata-viewer — local-only personal data.
# The eval corpus contains real household documents (names, medical, financial,
# school records) and the entity snapshot mirrors the Notion Entities DB.
# These stay on-disk and never reach this public repo.
experiments/pdf-metadata-viewer/eval/*
!experiments/pdf-metadata-viewer/eval/README.md
experiments/pdf-metadata-viewer/prototype/.entities-snapshot.json
experiments/pdf-metadata-viewer/prototype/activity-log.json
experiments/pdf-metadata-viewer/prototype/pdfs/*
!experiments/pdf-metadata-viewer/prototype/pdfs/.gitkeep

# Turbo's local task cache — one at the repo root and one per workspace package
# that runs a turbo task. Pure build output (tar.zst blobs plus manifests), it
# regenerates on demand and is machine-specific, so it must never be committed.
# Bare pattern, so it matches at any depth rather than only the root.
.turbo
