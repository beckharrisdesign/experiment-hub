# PDF Metadata Viewer — local configuration
#
# Copy to .env and fill in. This prototype runs locally only: it reads a
# directory of personal documents and queries a private Notion database, so it
# is never deployed. Do not add it to a hosting provider's env vars.

# ─── PDFs ─────────────────────────────────────────────────────────────────────
# Directory to read. Relative paths resolve against the prototype root.
# Absolute paths are used as-is. Google Drive mounts are detected and reported
# with a specific error when the client is closed or files are not synced.
PDFS_DIR=pdfs

# ─── Notion (entity taxonomy) ────────────────────────────────────────────────
# People and organizations come from the Notion Entities database, where `Slug`
# is the stable join key. The generic tag vocabulary lives in
# config/tag-vocabulary.md and needs no configuration.
#
# NOTION_TOKEN: an internal integration token with read access to the Entities
#   database. Create at https://www.notion.so/my-integrations, then share the
#   database with the integration.
# NOTION_ENTITIES_DATA_SOURCE_ID: the Entities *data source* id (not the page
#   or database id). Fetch the database via the API and read the data source id
#   from its `data_sources` array.
NOTION_TOKEN=
NOTION_ENTITIES_DATA_SOURCE_ID=

# After a successful fetch the entity list is cached to .entities-snapshot.json
# so the app keeps working offline. That file is gitignored — it mirrors
# personal data.

# ─── OpenAI (optional) ───────────────────────────────────────────────────────
# Only needed for AI metadata suggestions. Every other feature works without it.
OPENAI_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
# Defaults to 3004. 3001, 3002, 3003, 3009, and 3010 are taken by other
# experiment prototypes.
PORT=3004
